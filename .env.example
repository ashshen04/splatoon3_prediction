# Copy this to .env and fill in your values.
# Without DATABASE_URL the pipeline falls back to SQLite (splatoon3.db).

# Local Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/splatoon3

# Railway (copy the connection string from your Railway Postgres service)
# DATABASE_URL=postgresql://postgres:xxx@containers-us-west-xxx.railway.app:5432/railway
